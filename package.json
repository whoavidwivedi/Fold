{
  "name": "fold",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "api": "cd api && go run ./cmd/api",
    "migrate": "cd api && go run ./cmd/api --migrate-only",
    "codegen": "cd api && sqlc generate",
    "openapi": "cd api && go run ./cmd/api --print-openapi > ../openapi.json",
    "orval": "orval --config orval.config.ts",
    "db": "docker compose up -d db",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.19",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eventsource": "^5.1.3",
    "kysely": "0.28.8",
    "orval": "^8.43.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
