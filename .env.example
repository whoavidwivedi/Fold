# Copy to .env.local and fill in. Never commit the filled version.

# ---------------------------------------------------------------- Postgres
# Two URLs on purpose. Migrations need a superuser (CREATE EVENT TRIGGER requires one);
# the runtime connection must NOT be a superuser, because Postgres bypasses row level
# security for superusers and table owners — which would make every tenant policy
# decorative. See api/docker/init.sql.
DATABASE_URL=postgres://fold_app:fold_app@localhost:5432/postgres?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
TEST_DATABASE_URL=postgres://fold_app:fold_app@localhost:5432/postgres?sslmode=disable

# ---------------------------------------------------------------- Go API
ADDR=:8080
LOG_LEVEL=debug

# Where Better Auth is reachable from Go, and where its signing keys live.
AUTH_BASE_URL=http://localhost:3000
JWKS_URL=http://localhost:3000/api/auth/jwks

# Browser origins allowed to call the API. Needed in development because Next runs on
# :3000 and the API on :8080. Leave empty in production, where one reverse proxy serves
# both from a single origin and CORS is a no-op.
CORS_ORIGINS=http://localhost:3000

# Signs the 60-second SSE stream tokens. Must be at least 32 bytes.
# generate with: openssl rand -base64 32
STREAM_TOKEN_SECRET=

# ---------------------------------------------------------------- Next / auth
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. A provider is only registered when both values are present, so local dev
# works with email + password alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------------------------------------------------------------- Email
# Better Auth ships no email sender. This is Bring Your Own Provider.
# Resend free tier is 100 emails/day, which is a cliff — fine for dev, not for customers.
RESEND_API_KEY=
EMAIL_FROM=Fold <noreply@example.com>
